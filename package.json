{
  "name": "proof-studio",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"licence/*.test.mjs\" \"corpus/*.test.mjs\" \"lib/billing/*.test.mjs\" \"lib/*.test.mjs\" \"mcp/*.test.mjs\" \"scripts/*.test.mjs\" \"components/**/*.test.mjs\"",
    "report": "node report/run.mjs",
    "selfcheck": "node report/run.mjs .next/server/app/index.html --offline && node report/run.mjs .next/server/app/rulebook.html --offline && node report/run.mjs .next/server/app/terms.html --offline && node report/run.mjs .next/server/app/privacy.html --offline",
    "licence:boundary": "node scripts/check-licence-boundary.mjs",
    "mcp:shape": "node scripts/measure-mcp-shape.mjs",
    "claims:check": "node scripts/check-claims.mjs",
    "verify": "node scripts/release-verify.mjs",
    "plan:check": "node scripts/check-plan-claims.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "linkedom": "^0.18.13",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.48.0",
    "typescript": "^5.6.0"
  }
}
